FROM python:3.13-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1

RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/
RUN pip install --no-cache-dir -r requirements.txt Gunicorn

COPY . /app/

EXPOSE 8000

# Run migrations before serving traffic. Without this, a Docker/AWS deploy that
# ships new model fields (e.g. communications_notification.sender_id) serves code
# against a stale schema and every affected endpoint 500s. Matches render.yaml
# (gthread 2x4, timeout 60) which is sized for Starter instances.
CMD ["sh", "-c", "python manage.py migrate --noinput && gunicorn institute_crm.wsgi:application --bind 0.0.0.0:8000 --worker-class gthread --workers 2 --threads 4 --timeout 60"]
