# ---------------------------------------------------------------------------
# Template for institute_crm/.env  --  copy this file and fill in real values.
#   cp .env.example .env
#
# settings.py reads these at import time. Real environment variables always take
# precedence over this file, so the same settings module works in containers and CI.
# ---------------------------------------------------------------------------

# True only for local development. With DEBUG=False the project refuses to start
# unless DJANGO_SECRET_KEY is set, ALLOWED_HOSTS is explicit, and CORS is restricted.
DEBUG=True

# Required when DEBUG=False.
#   python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Comma-separated. Wildcards are rejected when DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_ALLOW_ALL_ORIGINS=False   # cannot be True when DEBUG=False

# ---------------------------------------------------------------------------
# PostgreSQL - REQUIRED
#
# This project does not support SQLite. DB_ENGINE must be
# django.db.backends.postgresql; any other value raises ImproperlyConfigured at
# startup. DB_PASSWORD has no default and must be provided.
# ---------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=Institute_CRM
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
TIME_ZONE=Asia/Kolkata
LOG_LEVEL=INFO
SQL_LOG_LEVEL=WARNING

JWT_ACCESS_MINUTES=480
JWT_REFRESH_DAYS=7

THROTTLE_ANON=60/min
THROTTLE_USER=1000/hour

# ---------------------------------------------------------------------------
# Uploads (profile photos, study material, documents)
# ---------------------------------------------------------------------------
MEDIA_URL=/media/
# MEDIA_ROOT=/var/lib/institute_crm/media
MAX_UPLOAD_SIZE_BYTES=5242880
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp

# Set a bucket to mirror uploads to S3. Blank keeps everything on local disk.
AWS_STORAGE_BUCKET_NAME=
AWS_REGION=ap-south-1
USE_S3_FOR_UPLOADS=False

# ---------------------------------------------------------------------------
# RAG - Phase 1 groundwork only; the `rag` app is not implemented yet.
# See RAG_IMPLEMENTATION_PLAN.md. Enabling this activates the pgvector
# readiness checks (crm.E002) in institute_crm/checks.py.
# ---------------------------------------------------------------------------
RAG_ENABLED=False
RAG_VECTOR_REPOSITORY=pgvector
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536

# Set automatically by the test runner; only override deliberately.
# IS_TESTING=False

# ---------------------------------------------------------------------------
# Production-only toggles (ignored while DEBUG=True)
# ---------------------------------------------------------------------------
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
