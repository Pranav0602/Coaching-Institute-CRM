# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/

# NOTE: `expo-env.d.ts` is deliberately *not* ignored. It carries the ambient
# `*.ttf` module declarations that make `npm run typecheck` pass, so it has to
# be committed like any other source file.

